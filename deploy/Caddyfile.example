{
	servers {
		trusted_proxies static 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
		client_ip_headers CF-Connecting-IP
	}
}

(cloudflare_origin) {
	tls /etc/caddy/certs/retrotide.app.pem /etc/caddy/certs/retrotide.app.key {
		client_auth {
			mode require_and_verify
			trust_pool file /etc/caddy/certs/cloudflare-origin-pull-ca.pem
		}
	}
}

(retrotide) {
	import cloudflare_origin

	log {
		format filter {
			wrap json
			request>uri query {
				delete code
				delete state
				delete token
			}
			request>headers>Referer delete
		}
	}

	@unlogged path /b/* /boards/* /api/v1/b/* /api/v1/boards/* /api/v1/ws
	log_skip @unlogged

	@internal path /metrics /debug/*
	respond @internal 404

	reverse_proxy 127.0.0.1:{args[0]} {
		header_up CF-Connecting-IP {client_ip}
	}
}

retrotide.app {
	import retrotide 2412
}

www.retrotide.app {
	import cloudflare_origin
	redir https://retrotide.app{uri} permanent
}

staging.retrotide.app {
	import retrotide 2413
	header >X-Robots-Tag "noindex, nofollow"
}

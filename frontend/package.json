{
    "name": "retrotide-frontend",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "npm run typecheck && vite build",
        "dev": "vite",
        "format": "oxfmt --check .",
        "format:fix": "oxfmt .",
        "lint": "oxlint --max-warnings=0 --disable-nested-config .",
        "lint:fix": "oxlint --disable-nested-config . --fix",
        "preview": "vite preview",
        "test": "vitest run",
        "test:coverage": "vitest run --coverage",
        "test:names": "node scripts/test-names.mjs",
        "test:watch": "vitest",
        "typecheck": "tsc -b"
    },
    "dependencies": {
        "@dnd-kit/collision": "^0.5.0",
        "@dnd-kit/dom": "^0.5.0",
        "@dnd-kit/react": "^0.5.0",
        "@tanstack/react-query": "^5.103.1",
        "dompurify": "^3.4.16",
        "html-to-image": "^1.11.13",
        "marked": "^18.0.14",
        "qrcode": "^1.5.4",
        "react": "^19.3.0",
        "react-dom": "^19.3.0",
        "react-router": "^8.4.0"
    },
    "devDependencies": {
        "@testing-library/dom": "^10.4.2",
        "@testing-library/jest-dom": "^7.0.1",
        "@testing-library/react": "^16.3.3",
        "@testing-library/user-event": "^14.6.7",
        "@types/qrcode": "^1.5.6",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@vitejs/plugin-react": "^6.1.1",
        "@vitest/coverage-v8": "^5.0.1",
        "jsdom": "^30.1.0",
        "oxfmt": "^0.68.0",
        "oxlint": "^1.83.0",
        "typescript": "^7.0.2",
        "vite": "^8.3.5",
        "vitest": "^5.0.1"
    }
}

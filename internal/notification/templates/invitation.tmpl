{{template "header" .}}
        <tr><td style="padding:32px 40px;">
          <h1 style="margin:0 0 16px;font-size:20px;line-height:1.3;color:#031630;">You are invited</h1>
          <p style="margin:0 0 16px;font-size:15px;line-height:1.6;color:#031630;">
            You are invited to join <strong><bdi>{{.SiteName}}</bdi></strong>. Use the button below to create your account for this address. You choose your name and password on the next page.
          </p>
          <p style="margin:0 0 24px;">
            <a href="{{.LinkURL}}" style="display:inline-block;padding:12px 24px;background:#1466ed;color:#ffffff;text-decoration:none;border-radius:8px;font-weight:600;font-size:15px;">Create your account</a>
          </p>
          <p style="margin:0 0 8px;font-size:13px;line-height:1.6;color:#45597a;">
            This link expires in 7 days and works once. If you were not expecting this invitation, ignore this email.
          </p>
          <p style="margin:0;font-size:12px;line-height:1.6;color:#45597a;word-break:break-all;">{{.LinkURL}}</p>
        </td></tr>
{{template "footer" .}}

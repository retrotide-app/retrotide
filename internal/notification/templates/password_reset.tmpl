{{template "header" .}}
        <tr><td style="padding:32px 40px;">
          <h1 style="margin:0 0 16px;font-size:20px;line-height:1.3;color:#031630;">Reset your password</h1>
          <p style="margin:0 0 16px;font-size:15px;line-height:1.6;color:#031630;">
            Someone asked to reset the password on your <strong><bdi>{{.SiteName}}</bdi></strong> account. Use the button below to choose a new one. Resetting it signs you out everywhere.
          </p>
          <p style="margin:0 0 24px;">
            <a href="{{.LinkURL}}" style="display:inline-block;padding:12px 24px;background:#1466ed;color:#ffffff;text-decoration:none;border-radius:8px;font-weight:600;font-size:15px;">Reset password</a>
          </p>
          <p style="margin:0 0 8px;font-size:13px;line-height:1.6;color:#45597a;">
            This link expires in one hour. If you did not ask to reset your password, ignore this email and your password stays as it is.
          </p>
          <p style="margin:0;font-size:12px;line-height:1.6;color:#45597a;word-break:break-all;">{{.LinkURL}}</p>
        </td></tr>
{{template "footer" .}}

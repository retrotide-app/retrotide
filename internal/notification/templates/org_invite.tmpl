{{template "header" .}}
        <tr><td style="padding:32px 40px;">
          <h1 dir="auto" style="margin:0 0 16px;font-size:20px;line-height:1.3;color:#031630;">Join <bdi>{{.Organisation}}</bdi></h1>
          <p dir="auto" style="margin:0 0 16px;font-size:15px;line-height:1.6;color:#031630;">
            {{if .InviterName}}<strong><bdi>{{.InviterName}}</bdi></strong> invited you{{else}}You are invited{{end}} to join <strong><bdi>{{.Organisation}}</bdi></strong> on <bdi>{{.SiteName}}</bdi>{{if .Admin}} as an admin{{end}}{{if .Team}}, in the team <strong><bdi>{{.Team}}</bdi></strong>{{end}}.
          </p>
          <p style="margin:0 0 24px;font-size:15px;line-height:1.6;color:#031630;">
            Use the button below to accept. If you do not have an account yet, you create one for this address when you accept.
          </p>
          <p style="margin:0 0 24px;">
            <a href="{{.LinkURL}}" style="display:inline-block;padding:12px 24px;background:#1466ed;color:#ffffff;text-decoration:none;border-radius:8px;font-weight:600;font-size:15px;">Accept the invite</a>
          </p>
          <p style="margin:0 0 8px;font-size:13px;line-height:1.6;color:#45597a;">
            This link expires in 7 days, works once and only for this email address. If you were not expecting this invitation, ignore this email.
          </p>
          <p style="margin:0;font-size:12px;line-height:1.6;color:#45597a;word-break:break-all;">{{.LinkURL}}</p>
        </td></tr>
{{template "footer" .}}

{{template "header" .}}
        <tr><td style="padding:32px 40px;">
          <h1 style="margin:0 0 16px;font-size:20px;line-height:1.3;color:#031630;">You have a new notification</h1>
          <p dir="auto" style="margin:0 0 24px;font-size:15px;line-height:1.6;color:#031630;">{{.Message}}</p>
          {{if .LinkURL}}
          <p style="margin:0 0 24px;">
            <a href="{{.LinkURL}}" style="display:inline-block;padding:12px 24px;background:#1466ed;color:#ffffff;text-decoration:none;border-radius:8px;font-weight:600;font-size:15px;">Open <bdi>{{.SiteName}}</bdi></a>
          </p>
          <p style="margin:0;font-size:12px;line-height:1.6;color:#45597a;word-break:break-all;">{{.LinkURL}}</p>
          {{end}}
        </td></tr>
{{template "footer" .}}

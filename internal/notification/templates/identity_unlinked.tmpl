{{template "header" .}}
        <tr><td style="padding:32px 40px;">
          <h1 style="margin:0 0 16px;font-size:20px;line-height:1.3;color:#031630;"><bdi>{{.Provider}}</bdi> sign-in was removed from your account</h1>
          <p style="margin:0 0 16px;font-size:15px;line-height:1.6;color:#031630;">
            The <bdi>{{.Provider}}</bdi> account <strong><bdi>{{.IdentityEmail}}</bdi></strong> was removed from the sign-in methods of your <strong><bdi>{{.SiteName}}</bdi></strong> account, and can no longer sign in to it.
          </p>
          <p style="margin:0 0 16px;font-size:15px;line-height:1.6;color:#031630;">
            If this was you, there is nothing more to do.
          </p>
          <p style="margin:0 0 24px;font-size:15px;line-height:1.6;color:#031630;">
            If this was <strong>not</strong> you, someone else can sign in to your account. Reset your password now, which signs you out everywhere.
          </p>
          <p style="margin:0 0 24px;">
            <a href="{{.ResetPasswordURL}}" style="display:inline-block;padding:12px 24px;background:#c62828;color:#ffffff;text-decoration:none;border-radius:8px;font-weight:600;font-size:15px;">Reset your password</a>
          </p>
          <p style="margin:0;font-size:12px;line-height:1.6;color:#45597a;word-break:break-all;">{{.ResetPasswordURL}}</p>
        </td></tr>
{{template "footer" .}}

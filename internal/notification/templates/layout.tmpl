{{define "header"}}<!DOCTYPE html>
<html lang="en-GB">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
</head>
<body style="margin:0;padding:0;background:#f5f9ff;color:#031630;font-family:system-ui,-apple-system,'Segoe UI',Roboto,'Helvetica Neue',Arial,sans-serif;">
  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background:#f5f9ff;padding:40px 16px;">
    <tr><td align="center">
      <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="max-width:600px;background:#ffffff;border:1px solid #d3e3f8;border-radius:12px;">
        <tr><td style="padding:24px 40px;border-bottom:1px solid #d3e3f8;">
          <p dir="auto" style="margin:0;font-size:20px;font-weight:800;color:#087cfa;"><bdi>{{.SiteName}}</bdi></p>
        </td></tr>
{{end}}

{{define "footer"}}
        <tr><td style="padding:16px 40px;border-top:1px solid #d3e3f8;text-align:center;">
          <p dir="auto" style="margin:0;font-size:12px;color:#45597a;"><bdi>{{.SiteName}}</bdi></p>
        </td></tr>
      </table>
    </td></tr>
  </table>
</body>
</html>
{{end}}

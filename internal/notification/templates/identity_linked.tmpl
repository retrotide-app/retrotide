{{template "header" .}}
        <tr><td style="padding:32px 40px;">
          <h1 style="margin:0 0 16px;font-size:20px;line-height:1.3;color:#031630;"><bdi>{{.Provider}}</bdi> sign-in was linked to your account</h1>
          <p style="margin:0 0 16px;font-size:15px;line-height:1.6;color:#031630;">
            {{if .Automatic}}Someone signed in to your <strong><bdi>{{.SiteName}}</bdi></strong> account with the <bdi>{{.Provider}}</bdi> account <strong><bdi>{{.IdentityEmail}}</bdi></strong>. <bdi>{{.Provider}}</bdi> hosts this email address, so the two were linked automatically, and every other device signed in to your account was signed out.{{else}}The <bdi>{{.Provider}}</bdi> account <strong><bdi>{{.IdentityEmail}}</bdi></strong> was linked to your <strong><bdi>{{.SiteName}}</bdi></strong> account from your account settings.{{end}} From now on it can sign in to your account.
          </p>
          <p style="margin:0 0 24px;font-size:15px;line-height:1.6;color:#031630;">
            If this was you, there is nothing more to do. If it was <strong>not</strong> you, remove it from your sign-in methods.
          </p>
          <p style="margin:0 0 24px;">
            <a href="{{.SignInMethodsURL}}" style="display:inline-block;padding:12px 24px;background:#1466ed;color:#ffffff;text-decoration:none;border-radius:8px;font-weight:600;font-size:15px;">Review your sign-in methods</a>
          </p>
          <p style="margin:0 0 24px;font-size:12px;line-height:1.6;color:#45597a;word-break:break-all;">{{.SignInMethodsURL}}</p>
          {{if .HasPassword}}
          <p style="margin:0 0 24px;font-size:15px;line-height:1.6;color:#031630;">
            Your account also has a password. The account was created on <strong>{{.AccountCreatedOn}}</strong>. If you did not set a password here, reset it now.
          </p>
          <p style="margin:0 0 24px;">
            <a href="{{.ResetPasswordURL}}" style="display:inline-block;padding:12px 24px;background:#c62828;color:#ffffff;text-decoration:none;border-radius:8px;font-weight:600;font-size:15px;">Reset your password</a>
          </p>
          <p style="margin:0;font-size:12px;line-height:1.6;color:#45597a;word-break:break-all;">{{.ResetPasswordURL}}</p>
          {{end}}
        </td></tr>
{{template "footer" .}}
